{
  "name": "commandcodex",
  "version": "1.0.0",
  "private": true,
  "description": "A local Responses bridge that runs Codex on every Command Code model via the official Provider API.",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "bin": {
    "commandcodex": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts serve",
    
    "models": "bun run src/cli.ts models",
    "doctor": "bun run src/cli.ts doctor",
    "test": "bun test tests/*.test.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT"
}
